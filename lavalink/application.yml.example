server:
  port: 2333
  address: 0.0.0.0
plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    clients:
      - TV
      - ANDROID_VR
      - WEB
      - MWEB
      - TVHTML5_SIMPLY
      - ANDROID_MUSIC
      - WEBEMBEDDED
    oauth:
      enabled: true
      skipInitialization: true
      refreshToken: "${YOUTUBE_REFRESH_TOKEN}"
    # Handles YouTube's changing player-signature scripts outside the plugin parser.
    remoteCipher:
      url: "https://cipher.kikkia.dev/"
      userAgent: "homies_music"
lavalink:
  plugins:
    # Pinned snapshot includes the current TV client User-Agent playback fix.
    - dependency: "dev.lavalink.youtube:youtube-plugin:2be8e542d3f6f178e048dca565892684c2e40177"
      repository: "https://maven.lavalink.dev/snapshots"
      snapshot: true
  server:
    password: "${LAVALINK_PASSWORD}"
    sources:
      youtube: false
      soundcloud: true
      bandcamp: true
      http: true
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true
logging:
  level:
    root: INFO
    lavalink: INFO
